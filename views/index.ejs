<%- include('partials/header') %>

<!-- 토큰 설정을 위한 안내 (테스트용) -->
<div id="auth-status" style="background: #ebf5fb; padding: 10px; border-radius: 8px; margin-bottom: 20px; font-size: 0.9rem; border: 1px solid #d6eaf8;">
    🔑 <strong>인증 안내:</strong> 현재 로그인이 필요합니다. API로 받은 토큰을 브라우저에 저장해야 심부름을 등록할 수 있습니다.
    <div style="margin-top: 5px;">
        <input type="text" id="token-input" placeholder="여기에 JWT 토큰을 붙여넣으세요" style="width: 70%; padding: 5px;">
        <button onclick="saveToken()" style="padding: 5px 10px; cursor: pointer;">토큰 저장</button>
    </div>
</div>

<section class="request-form-card">
    <h2>🚀 새로운 심부름 요청하기</h2>
    <form id="errand-form">
        <div class="form-group">
            <label for="title">제목</label>
            <input type="text" id="title" name="title" placeholder="예: 도서관에서 책 좀 빌려주실 분!" required>
        </div>
        <div class="row" style="display: flex; gap: 1rem;">
            <div class="form-group" style="flex: 1;">
                <label for="category">카테고리</label>
                <select id="category" name="category" required>
                    <option value="Delivery">배달</option>
                    <option value="Shopping">구매대행</option>
                    <option value="Labor">단순노동</option>
                    <option value="Etc">기타</option>
                </select>
            </div>
            <div class="form-group" style="flex: 1;">
                <label for="reward">보상 (원)</label>
                <input type="number" id="reward" name="reward" placeholder="예: 3000" required>
            </div>
        </div>
        <div class="form-group">
            <label for="description">상세 내용</label>
            <textarea id="description" name="description" rows="3" placeholder="구체적인 도움 내용을 입력해주세요." required></textarea>
        </div>
        <div class="form-group">
            <label for="expiredAt">만료 시간</label>
            <input type="datetime-local" id="expiredAt" name="expiredAt" required>
        </div>
        <button type="submit" class="btn-submit">심부름 등록하기</button>
    </form>
</section>

<div class="dashboard-header">
    <h2>📌 실시간 심부름 목록</h2>
    <span>총 <%= errands.length %>개의 요청이 있습니다.</span>
</div>

<div class="errand-grid">
    <% if (errands.length === 0) { %>
        <p>현재 등록된 심부름이 없습니다. 첫 번째 요청을 등록해 보세요!</p>
    <% } %>
    
    <% errands.forEach(errand => { %>
        <div class="errand-card">
            <span class="status-badge status-<%= errand.status.toLowerCase() %>">
                <%= errand.status === 'PENDING' ? '모집 중' : (errand.status === 'MATCHED' ? '매칭 완료' : '완료됨') %>
            </span>
            <h3><%= errand.title %></h3>
            <span class="category">#<%= errand.category %></span>
            <p><%= errand.description.length > 80 ? errand.description.substring(0, 80) + '...' : errand.description %></p>
            <div class="reward">
                <%= errand.reward.toLocaleString() %>원
            </div>
        </div>
    <% }) %>
</div>

<script>
    // 토큰 저장 함수
    function saveToken() {
        const token = document.getElementById('token-input').value;
        if (token) {
            localStorage.setItem('jwtToken', token);
            alert('토큰이 저장되었습니다! 이제 심부름을 등록할 수 있습니다.');
            location.reload();
        }
    }

    // 페이지 로드 시 토큰 확인
    document.addEventListener('DOMContentLoaded', () => {
        const token = localStorage.getItem('jwtToken');
        if (token) {
            document.getElementById('auth-status').innerHTML = '✅ <strong>인증 완료:</strong> 현재 등록 권한이 활성화되었습니다.';
            document.getElementById('auth-status').style.background = '#d4edda';
            document.getElementById('auth-status').style.borderColor = '#c3e6cb';
        }
    });

    // 폼 제출 이벤트 처리
    document.getElementById('errand-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const token = localStorage.getItem('jwtToken');
        if (!token) {
            alert('인증 토큰이 없습니다. 먼저 로그인을 하거나 토큰을 입력해 주세요.');
            return;
        }

        const formData = {
            title: document.getElementById('title').value,
            category: document.getElementById('category').value,
            reward: document.getElementById('reward').value,
            description: document.getElementById('description').value,
            expiredAt: document.getElementById('expiredAt').value
        };

        try {
            const response = await fetch('/api/errands', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (response.ok) {
                alert('심부름이 성공적으로 등록되었습니다!');
                location.reload(); // 목록 갱신
            } else {
                alert('등록 실패: ' + (result.message || '알 수 없는 오류'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('서버 통신 중 오류가 발생했습니다.');
        }
    });
</script>

<%- include('partials/footer') %>
